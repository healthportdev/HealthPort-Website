# HealthPort website — environment configuration
# Copy to .env.local (dev) and set the same values in Netlify's env-vars
# UI for production. NEVER commit .env or .env.local — only .env.example
# belongs in the repo.

# ── Contact form (server-side) ─────────────────────────────────────────
# Resend API key. Get it from https://resend.com → API Keys.
# Server-side only (no NEXT_PUBLIC prefix) — this must never reach the
# browser.
RESEND_API_KEY=

# Verified "from" address. Must be a domain you've verified in Resend.
# Can be a simple address or a formatted "Name <address>" pair.
# Examples:
#   noreply@healthportafrica.com
#   HealthPort <noreply@healthportafrica.com>
CONTACT_FROM_EMAIL=

# Optional comma-separated list of bcc addresses that receive a copy
# of every submission (useful for an internal audit inbox).
# Example: audit@healthportafrica.com,ops@healthportafrica.com
CONTACT_BCC=

# ── Contact form (client-side, optional) ───────────────────────────────
# By default the form POSTs to /api/contact (the built-in Next.js route
# that uses Resend). Only set this if you want to point the form at a
# different endpoint (Formspree, external webhook, etc.).
# Example: NEXT_PUBLIC_CONTACT_ENDPOINT="https://formspree.io/f/xyz..."
NEXT_PUBLIC_CONTACT_ENDPOINT=

# ── Site URL ───────────────────────────────────────────────────────────
# Only needed if the production domain changes from healthportafrica.com.
# Used for sitemap.ts, robots.ts, canonical URLs, and OG tags.
# NEXT_PUBLIC_SITE_URL=https://healthportafrica.com
